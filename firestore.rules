rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FAMILY TEST BUILD ONLY.
    // Game codes are random four-character session identifiers.
    // Harden before any public/large-scale deployment.

    match /iktGameStates/{gameCode} {
      allow read, create, update, delete: if true;
    }

    match /iktDisplays/{gameCode} {
      allow read, create, update, delete: if true;
    }
  }
}
